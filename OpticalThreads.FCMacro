# -*- coding: utf-8 -*-
"""
FreeCAD Optical Threads - v0.2.0
T2 / M42 x 0.75 internal threaded sleeve generator.

Native Part Design redesign:
- creates a PartDesign Body
- creates the sleeve with native additive/subtractive cylinders
- creates a simple ideal 60 degree triangular thread profile on the XZ plane
- creates the female thread with PartDesign::SubtractiveHelix
- preserves practical fit controls and PETG shrinkage compensation

This follows FreeCAD's native Part Design helix workflow instead of building
custom PipeShell/Loft thread cutters in the Part workbench API.

License: MIT
"""

import math
import FreeCAD as App
import Part
import Sketcher

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


FIT_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.05,
    "Normal": 0.10,
    "Loose": 0.20,
    "FDM print": 0.20,
    "Custom": None,
}

ROOT_RELIEF_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.00,
    "Normal": 0.00,
    "Loose": 0.05,
    "FDM print": 0.10,
    "Custom": None,
}

CREST_TRUNC_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.00,
    "Normal": 0.00,
    "Loose": 0.025,
    "FDM print": 0.05,
    "Custom": None,
}

MATERIAL_PROCESS_PRESETS = {
    "No compensation": 0.0,
    "3D PETG": 0.7,
}


def _add_info_property(obj, prop_type, name, group, value):
    try:
        obj.addProperty(prop_type, name, group)
    except Exception:
        pass
    setattr(obj, name, value)


def create_t2_internal(
    length=8.0,
    wall_thickness=3.0,
    fit="FDM print",
    material_process="3D PETG",
    shrinkage_percent=None,
    custom_clearance=None,
    root_relief=None,
    crest_truncation=None,
    right_hand=True,
    document=None,
):
    doc = document or App.ActiveDocument
    if doc is None:
        doc = App.newDocument("OpticalThreads")

    fit = fit if fit in FIT_PRESETS else "FDM print"
    material_process = (
        material_process
        if material_process in MATERIAL_PROCESS_PRESETS
        else "No compensation"
    )

    clearance0 = FIT_PRESETS[fit]
    root_relief0 = ROOT_RELIEF_PRESETS[fit]
    crest_trunc0 = CREST_TRUNC_PRESETS[fit]

    if fit == "Custom":
        clearance0 = 0.20 if custom_clearance is None else float(custom_clearance)
        root_relief0 = 0.10 if root_relief is None else float(root_relief)
        crest_trunc0 = 0.05 if crest_truncation is None else float(crest_truncation)

    shrink0 = MATERIAL_PROCESS_PRESETS[material_process]
    if shrinkage_percent is not None:
        shrink0 = float(shrinkage_percent)

    if shrink0 < 0.0 or shrink0 >= 100.0:
        raise ValueError("Shrinkage percentage must be >= 0 and < 100")

    # Nominal T2 geometry.
    d0 = 42.0
    p0 = 0.75
    length0 = float(length)
    wall0 = float(wall_thickness)

    if min(length0, wall0) <= 0:
        raise ValueError("Length and wall thickness must be > 0")

    # Exact inverse linear compensation. 0.7% PETG -> 1/0.993.
    scale = 1.0 / (1.0 - shrink0 / 100.0)

    d = d0 * scale
    p = p0 * scale
    body_length = length0 * scale
    wall = wall0 * scale
    clearance = float(clearance0) * scale
    root_relief_cad = float(root_relief0) * scale
    crest_trunc_cad = float(crest_trunc0) * scale

    # Same fit model used by the print-tested versions.
    basic_minor_d = d - 1.082531754 * p
    crest_d = basic_minor_d + clearance + 2.0 * crest_trunc_cad
    root_d = d + clearance + 2.0 * root_relief_cad

    r_crest = crest_d / 2.0
    r_root = root_d / 2.0
    r_outer = d / 2.0 + wall
    thread_depth = r_root - r_crest

    if thread_depth <= 0:
        raise ValueError("Invalid thread profile depth")
    if r_outer <= r_root + 0.1:
        raise ValueError("Wall thickness is too small for the selected thread")

    body = doc.addObject("PartDesign::Body", "T2_M42x0_75_Internal")
    body.Label = "T2 M42x0.75 Internal Thread v0.2.0"

    # Store the important design values on the Body for easy inspection.
    _add_info_property(body, "App::PropertyString", "ThreadDesignation", "Thread", "T2 / M42 x 0.75 internal")
    _add_info_property(body, "App::PropertyLength", "NominalDiameter", "Thread", d0)
    _add_info_property(body, "App::PropertyLength", "NominalPitch", "Thread", p0)
    _add_info_property(body, "App::PropertyLength", "CADPitch", "Thread", p)
    _add_info_property(body, "App::PropertyString", "FitPreset", "Fit", fit)
    _add_info_property(body, "App::PropertyLength", "DiametralClearance", "Fit", clearance0)
    _add_info_property(body, "App::PropertyLength", "RootRelief", "Fit", root_relief0)
    _add_info_property(body, "App::PropertyLength", "CrestTruncation", "Fit", crest_trunc0)
    _add_info_property(body, "App::PropertyString", "MaterialProcess", "Print compensation", material_process)
    _add_info_property(body, "App::PropertyFloat", "ShrinkagePercent", "Print compensation", shrink0)
    _add_info_property(body, "App::PropertyFloat", "CompensationScale", "Print compensation", scale)
    _add_info_property(body, "App::PropertyLength", "EffectiveCrestDiameter", "Information", crest_d)
    _add_info_property(body, "App::PropertyLength", "EffectiveRootDiameter", "Information", root_d)
    _add_info_property(body, "App::PropertyLength", "EffectiveRadialDepth", "Information", thread_depth)
    _add_info_property(body, "App::PropertyString", "GenerationMethod", "Information", "Native PartDesign::SubtractiveHelix with ideal 60 degree triangle")

    # 1) Native solid sleeve.
    outer = body.newObject("PartDesign::AdditiveCylinder", "SleeveOuter")
    outer.Label = "Sleeve outer cylinder"
    outer.Radius = r_outer
    outer.Height = body_length
    outer.Angle = 360
    doc.recompute()

    bore_eps = max(0.03, 0.04 * p)
    bore = body.newObject("PartDesign::SubtractiveCylinder", "SleeveBore")
    bore.Label = "Female thread crest bore"
    bore.Radius = r_crest
    bore.Height = body_length + 2.0 * bore_eps
    bore.Angle = 360
    bore.Placement = App.Placement(
        App.Vector(0, 0, -bore_eps),
        App.Rotation(App.Vector(0, 0, 1), 0),
    )
    doc.recompute()

    if bore.Shape.isNull() or len(bore.Shape.Solids) != 1 or not bore.Shape.isValid():
        raise RuntimeError("Native PartDesign sleeve/bore produced an invalid base solid")

    # 2) Ideal 60 degree triangular profile on the XZ plane.
    # The triangle points radially outward. With half-width = depth*tan(30 deg),
    # the included angle at the tip is exactly 60 degrees; no crest/root flattening
    # is introduced into the sketch itself.
    profile = body.newObject("Sketcher::SketchObject", "ThreadProfile")
    profile.Label = "M42x0.75 ideal 60 degree thread triangle"
    xz_plane = body.Origin.OriginFeatures[4]
    profile.AttachmentSupport = xz_plane
    profile.MapMode = "FlatFace"

    # Start one pitch below the sleeve and finish one pitch above it. This keeps
    # the ends fully threaded and avoids making the helix start exactly on a face.
    z_start = -p
    radial_height = thread_depth
    half_width = radial_height * math.tan(math.radians(30.0))

    q1 = App.Vector(r_crest, z_start - half_width, 0)
    q2 = App.Vector(r_root, z_start, 0)
    q3 = App.Vector(r_crest, z_start + half_width, 0)

    profile.addGeometry([
        Part.LineSegment(q1, q2),
        Part.LineSegment(q2, q3),
        Part.LineSegment(q3, q1),
    ], False)
    doc.recompute()

    # 3) Native Part Design subtractive helix, following FreeCAD's own test pattern.
    helix = body.newObject("PartDesign::SubtractiveHelix", "ThreadHelix")
    helix.Label = "T2 M42x0.75 subtractive helix"
    helix.Profile = profile
    helix.ReferenceAxis = (profile, ["V_Axis"])
    helix.Mode = 0
    helix.Pitch = p
    helix.Height = body_length + 2.0 * p
    helix.Turns = helix.Height.Value / p
    helix.Angle = 0
    helix.Growth = 0
    helix.LeftHanded = not bool(right_hand)
    helix.Reversed = 0
    doc.recompute()

    if helix.Shape.isNull():
        raise RuntimeError("Native SubtractiveHelix returned a null shape")
    if len(helix.Shape.Solids) != 1:
        raise RuntimeError(
            "Native SubtractiveHelix must produce one solid; got %d" % len(helix.Shape.Solids)
        )
    if not helix.Shape.isValid():
        raise RuntimeError("Native SubtractiveHelix produced an invalid solid")

    try:
        outer.ViewObject.Visibility = False
        bore.ViewObject.Visibility = False
        profile.ViewObject.Visibility = False
        helix.ViewObject.Deviation = 0.05
        helix.ViewObject.AngularDeflection = 10.0
    except Exception:
        pass

    body.Tip = helix
    doc.recompute()

    if Gui:
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()

    return body


def _show_dialog():
    if Gui is None:
        return create_t2_internal()

    try:
        from PySide import QtGui
        QtWidgets = QtGui
    except Exception:
        from PySide2 import QtWidgets

    dlg = QtWidgets.QDialog()
    dlg.setWindowTitle("T2 / M42 x 0.75 Internal Thread v0.2.0")
    layout = QtWidgets.QFormLayout(dlg)

    length_box = QtWidgets.QDoubleSpinBox()
    length_box.setRange(0.75, 200.0)
    length_box.setDecimals(3)
    length_box.setValue(8.0)
    length_box.setSuffix(" mm")

    wall_box = QtWidgets.QDoubleSpinBox()
    wall_box.setRange(0.5, 50.0)
    wall_box.setDecimals(3)
    wall_box.setValue(3.0)
    wall_box.setSuffix(" mm")

    fit_box = QtWidgets.QComboBox()
    for name in FIT_PRESETS:
        fit_box.addItem(name)
    fit_box.setCurrentText("FDM print")

    material_box = QtWidgets.QComboBox()
    for name in MATERIAL_PROCESS_PRESETS:
        material_box.addItem(name)
    material_box.setCurrentText("3D PETG")

    shrinkage_box = QtWidgets.QDoubleSpinBox()
    shrinkage_box.setRange(0.0, 20.0)
    shrinkage_box.setDecimals(3)
    shrinkage_box.setSingleStep(0.1)
    shrinkage_box.setSuffix(" %")
    shrinkage_box.setValue(MATERIAL_PROCESS_PRESETS["3D PETG"])

    clearance_box = QtWidgets.QDoubleSpinBox()
    clearance_box.setRange(-0.5, 2.0)
    clearance_box.setDecimals(3)
    clearance_box.setSingleStep(0.05)
    clearance_box.setSuffix(" mm dia")
    clearance_box.setValue(FIT_PRESETS["FDM print"])

    root_box = QtWidgets.QDoubleSpinBox()
    root_box.setRange(0.0, 1.0)
    root_box.setDecimals(3)
    root_box.setSingleStep(0.025)
    root_box.setSuffix(" mm radial")
    root_box.setValue(ROOT_RELIEF_PRESETS["FDM print"])

    crest_box = QtWidgets.QDoubleSpinBox()
    crest_box.setRange(0.0, 0.5)
    crest_box.setDecimals(3)
    crest_box.setSingleStep(0.025)
    crest_box.setSuffix(" mm radial")
    crest_box.setValue(CREST_TRUNC_PRESETS["FDM print"])

    def fit_changed(name):
        name = str(name)
        custom = name == "Custom"
        clearance_box.setEnabled(custom)
        root_box.setEnabled(custom)
        crest_box.setEnabled(custom)
        if not custom:
            clearance_box.setValue(FIT_PRESETS[name])
            root_box.setValue(ROOT_RELIEF_PRESETS[name])
            crest_box.setValue(CREST_TRUNC_PRESETS[name])

    def material_changed(name):
        value = MATERIAL_PROCESS_PRESETS.get(str(name))
        if value is not None:
            shrinkage_box.setValue(value)

    fit_box.currentTextChanged.connect(fit_changed)
    material_box.currentTextChanged.connect(material_changed)
    fit_changed("FDM print")
    material_changed("3D PETG")

    layout.addRow("Thread:", QtWidgets.QLabel("T2 / M42 x 0.75 internal"))
    layout.addRow("Length:", length_box)
    layout.addRow("Wall thickness:", wall_box)
    layout.addRow("Fit:", fit_box)
    layout.addRow("Material / process:", material_box)
    layout.addRow("Shrinkage / compression:", shrinkage_box)
    layout.addRow("Diametral clearance:", clearance_box)
    layout.addRow("Root relief:", root_box)
    layout.addRow("Crest truncation:", crest_box)

    note = QtWidgets.QLabel(
        "v0.2.0 uses a native Part Design Subtractive Helix with an ideal 60 degree triangle.\n"
        "No custom PipeShell or lofted thread cutter is used."
    )
    layout.addRow(note)

    buttons = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
    )
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout.addRow(buttons)

    if dlg.exec_():
        fit = str(fit_box.currentText())
        return create_t2_internal(
            length=length_box.value(),
            wall_thickness=wall_box.value(),
            fit=fit,
            material_process=str(material_box.currentText()),
            shrinkage_percent=shrinkage_box.value(),
            custom_clearance=(clearance_box.value() if fit == "Custom" else None),
            root_relief=(root_box.value() if fit == "Custom" else None),
            crest_truncation=(crest_box.value() if fit == "Custom" else None),
        )
    return None


_show_dialog()
