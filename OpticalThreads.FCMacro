# -*- coding: utf-8 -*-
"""
FreeCAD Optical Threads - v0.1.1
T2 / M42 x 0.75 internal threaded sleeve generator.

The user selects length, wall thickness and practical fit/clearance.
The macro creates a parametric FeaturePython solid.

License: MIT
"""

import math
import FreeCAD as App
import Part

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


FIT_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.05,
    "Normal": 0.10,
    "Loose": 0.20,
    "FDM print": 0.30,
    "Custom": None,
}


class T2InternalThreadProxy:
    """Parametric M42x0.75 internal threaded sleeve."""

    Type = "FreeCADOpticalThreads::T2Internal"

    def __init__(self, obj):
        obj.Proxy = self

        obj.addProperty("App::PropertyString", "ThreadDesignation", "Thread")
        obj.ThreadDesignation = "T2 / M42 x 0.75 internal"

        obj.addProperty("App::PropertyLength", "NominalDiameter", "Thread")
        obj.NominalDiameter = 42.0

        obj.addProperty("App::PropertyLength", "Pitch", "Thread")
        obj.Pitch = 0.75

        obj.addProperty("App::PropertyLength", "Length", "Geometry")
        obj.Length = 8.0

        obj.addProperty("App::PropertyLength", "WallThickness", "Geometry")
        obj.WallThickness = 3.0

        obj.addProperty(
            "App::PropertyEnumeration",
            "Fit",
            "Fit",
            "Practical fit preset; clearance is diametral.",
        )
        obj.Fit = list(FIT_PRESETS.keys())
        obj.Fit = "Normal"

        obj.addProperty(
            "App::PropertyLength",
            "DiametralClearance",
            "Fit",
            "Amount added to the female thread diameters.",
        )
        obj.DiametralClearance = FIT_PRESETS["Normal"]

        obj.addProperty("App::PropertyBool", "RightHand", "Thread")
        obj.RightHand = True

        obj.addProperty(
            "App::PropertyAngle",
            "SeamOffset",
            "Advanced",
            "Rotates the helix away from the cylindrical seam for robust booleans.",
        )
        obj.SeamOffset = 30.0

        obj.addProperty("App::PropertyString", "ProfileNote", "Information")
        obj.ProfileNote = (
            "60 degree metric-style V profile. Female basic minor diameter "
            "D1 = D - 1.082531754*P. Fit presets are practical clearances, "
            "not certified ISO tolerance classes."
        )

        obj.setEditorMode("ThreadDesignation", 1)
        obj.setEditorMode("NominalDiameter", 1)
        obj.setEditorMode("Pitch", 1)
        obj.setEditorMode("ProfileNote", 1)

    def onChanged(self, obj, prop):
        if prop == "Fit":
            preset = FIT_PRESETS.get(str(obj.Fit))
            if preset is not None:
                obj.DiametralClearance = preset

    def execute(self, obj):
        d = float(obj.NominalDiameter.Value)
        p = float(obj.Pitch.Value)
        length = float(obj.Length.Value)
        wall = float(obj.WallThickness.Value)
        clearance_d = float(obj.DiametralClearance.Value)
        seam_offset = float(obj.SeamOffset)

        if d <= 0 or p <= 0 or length <= 0 or wall <= 0:
            raise ValueError("Diameter, pitch, length and wall thickness must be > 0")

        # ISO metric basic female-thread minor diameter.
        basic_minor_d = d - 1.082531754 * p
        minor_d = basic_minor_d + clearance_d
        major_d = d + clearance_d

        r_minor = minor_d / 2.0
        r_major = major_d / 2.0
        r_outer = d / 2.0 + wall

        if r_outer <= r_major:
            raise ValueError("Wall thickness is too small for the selected fit")

        # Make the plain sleeve first. The bore is the female minor diameter;
        # the helical cutter will open the V groove outward to the major diameter.
        eps = max(0.02, p * 0.03)
        outer = Part.makeCylinder(r_outer, length)
        bore = Part.makeCylinder(
            r_minor,
            length + 2.0 * eps,
            App.Vector(0, 0, -eps),
        )
        sleeve = outer.cut(bore)

        # Extend the thread by one pitch at each end and trim it naturally with
        # the finite sleeve. Long boolean operations are less reliable in OCC.
        helix_z0 = -p
        helix_height = length + 2.0 * p
        r_path = (r_minor + r_major) / 2.0

        helix = Part.makeHelix(
            p,
            helix_height,
            r_path,
            0,
            not bool(obj.RightHand),
        )
        helix.translate(App.Vector(0, 0, helix_z0))

        # IMPORTANT: FreeCAD/OCC cylinders have a seam. Starting the helix on
        # the same seam can make a boolean cut silently fail. Rotate the helix
        # and its section together away from that seam.
        z_axis = App.Vector(0, 0, 1)
        origin = App.Vector(0, 0, 0)
        helix.rotate(origin, z_axis, seam_offset)

        # 60-degree included V profile. Full axial width is intentionally less
        # than the 0.75 mm pitch so adjacent turns cannot self-intersect.
        depth = r_major - r_minor
        half_width = depth * math.tan(math.radians(30.0))

        # Give the cutter a healthy overlap into the already-open bore. Tiny
        # coincident/tangent overlaps are a common OCC boolean failure mode.
        overlap = max(0.08, depth * 0.20)

        p1 = App.Vector(r_minor - overlap, 0, helix_z0 - half_width)
        p2 = App.Vector(r_major + 0.03, 0, helix_z0)
        p3 = App.Vector(r_minor - overlap, 0, helix_z0 + half_width)

        e1 = Part.makeLine(p1, p2)
        e2 = Part.makeLine(p2, p3)
        e3 = Part.makeLine(p3, p1)
        profile = Part.Wire([e1, e2, e3])
        profile.rotate(origin, z_axis, seam_offset)

        spine = Part.Wire(helix.Edges)
        cutter = spine.makePipeShell([profile], True, True)

        if cutter.isNull() or not cutter.Solids:
            raise RuntimeError("The helical sweep did not create a solid cutter")

        # Do not silently return a smooth ring. Verify that the helical cutter
        # actually intersects the sleeve before performing the final cut.
        intersection = sleeve.common(cutter)
        if intersection.isNull() or intersection.Volume < 1.0e-6:
            raise RuntimeError(
                "Thread cutter does not intersect the sleeve. "
                "Try changing SeamOffset (for example 20-45 deg)."
            )

        result = sleeve.cut(cutter)

        if result.isNull():
            raise RuntimeError("Thread boolean cut produced a null shape")
        if hasattr(result, "isValid") and not result.isValid():
            raise RuntimeError("Thread boolean cut produced an invalid shape")

        try:
            result = result.removeSplitter()
        except Exception:
            pass

        obj.Shape = result

        # Better visual tessellation for the fine 0.75 mm thread.
        try:
            obj.ViewObject.Deviation = 0.08
            obj.ViewObject.AngularDeflection = 15.0
        except Exception:
            pass


class T2InternalViewProvider:
    def __init__(self, vobj):
        vobj.Proxy = self

    def getIcon(self):
        return ""

    def attach(self, vobj):
        self.ViewObject = vobj

    def updateData(self, obj, prop):
        pass

    def onChanged(self, vobj, prop):
        pass

    def getDisplayModes(self, vobj):
        return []

    def getDefaultDisplayMode(self):
        return "Flat Lines"

    def setDisplayMode(self, mode):
        return mode

    def dumps(self):
        return None

    def loads(self, state):
        return None


def create_t2_internal(
    length=8.0,
    wall_thickness=3.0,
    fit="Normal",
    custom_clearance=None,
    document=None,
):
    """Create one parametric T2 / M42x0.75 internal threaded sleeve."""
    doc = document or App.ActiveDocument
    if doc is None:
        doc = App.newDocument("OpticalThreads")

    obj = doc.addObject("PartDesign::FeaturePython", "T2_M42x0_75_Internal")
    obj.Label = "T2 M42x0.75 Internal Thread"

    T2InternalThreadProxy(obj)
    if Gui:
        T2InternalViewProvider(obj.ViewObject)

    obj.Length = float(length)
    obj.WallThickness = float(wall_thickness)

    if fit not in FIT_PRESETS:
        fit = "Normal"
    obj.Fit = fit

    if fit == "Custom" and custom_clearance is not None:
        obj.DiametralClearance = float(custom_clearance)

    doc.recompute()

    if Gui:
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()

    return obj


def _show_dialog():
    if Gui is None:
        return create_t2_internal()

    try:
        from PySide import QtGui
        QtWidgets = QtGui
    except Exception:
        try:
            from PySide2 import QtWidgets
        except Exception:
            return create_t2_internal()

    dlg = QtWidgets.QDialog()
    dlg.setWindowTitle("T2 / M42 x 0.75 Internal Thread")
    layout = QtWidgets.QFormLayout(dlg)

    length_box = QtWidgets.QDoubleSpinBox()
    length_box.setRange(0.75, 200.0)
    length_box.setDecimals(3)
    length_box.setSingleStep(0.5)
    length_box.setValue(8.0)
    length_box.setSuffix(" mm")

    wall_box = QtWidgets.QDoubleSpinBox()
    wall_box.setRange(0.5, 50.0)
    wall_box.setDecimals(3)
    wall_box.setSingleStep(0.5)
    wall_box.setValue(3.0)
    wall_box.setSuffix(" mm")

    fit_box = QtWidgets.QComboBox()
    for name in FIT_PRESETS:
        fit_box.addItem(name)
    fit_box.setCurrentText("Normal")

    clearance_box = QtWidgets.QDoubleSpinBox()
    clearance_box.setRange(-0.50, 2.00)
    clearance_box.setDecimals(3)
    clearance_box.setSingleStep(0.05)
    clearance_box.setValue(FIT_PRESETS["Normal"])
    clearance_box.setSuffix(" mm dia")

    def fit_changed(name):
        value = FIT_PRESETS.get(str(name))
        if value is not None:
            clearance_box.setValue(value)
            clearance_box.setEnabled(False)
        else:
            clearance_box.setEnabled(True)

    fit_box.currentTextChanged.connect(fit_changed)
    fit_changed("Normal")

    layout.addRow("Thread:", QtWidgets.QLabel("T2 / M42 x 0.75 internal"))
    layout.addRow("Length:", length_box)
    layout.addRow("Wall thickness:", wall_box)
    layout.addRow("Fit:", fit_box)
    layout.addRow("Diametral clearance:", clearance_box)

    buttons = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
    )
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout.addRow(buttons)

    if dlg.exec_():
        fit = str(fit_box.currentText())
        return create_t2_internal(
            length=length_box.value(),
            wall_thickness=wall_box.value(),
            fit=fit,
            custom_clearance=clearance_box.value(),
        )
    return None


_show_dialog()
