# -*- coding: utf-8 -*-
"""FreeCAD Optical Threads v0.5.2 - native male/female/matched metric threads."""
import math
import FreeCAD as App
import Part, Sketcher
try:
    import FreeCADGui as Gui
except Exception:
    Gui=None

THREAD_STANDARDS={
 "T2 / M42 x 0.75":dict(designation="T2 / M42 x 0.75",diameter=42.0,pitch=0.75,profile_angle=60.0,family="ISO metric 60 degree profile",verified=True),
 "1.25in Filter / M28.5 x 0.6":dict(designation="1.25in Filter / M28.5 x 0.6",diameter=28.5,pitch=0.6,profile_angle=60.0,family="Astronomy 1.25-inch filter/eyepiece metric thread",verified=True),
 "Custom metric":None,
}
FIT_PRESETS={
 "Basic / nominal":dict(diametral_clearance=0.00,root_relief=0.00,crest_truncation=0.00),
 "Close":dict(diametral_clearance=0.05,root_relief=0.00,crest_truncation=0.00),
 "Normal":dict(diametral_clearance=0.10,root_relief=0.00,crest_truncation=0.00),
 "Loose":dict(diametral_clearance=0.20,root_relief=0.05,crest_truncation=0.025),
 "FDM print":dict(diametral_clearance=0.20,root_relief=0.10,crest_truncation=0.05),
 "Custom":None,
}
MATERIAL_PROCESS_PRESETS={"No compensation":0.0,"3D PETG":0.7}
OUTPUT_MODES=("Internal / female","External / male","Matched pair")

def _prop(o,t,n,g,v):
    try:o.addProperty(t,n,g)
    except Exception:pass
    setattr(o,n,v)
    try:o.setEditorMode(n,1)
    except Exception:pass

def _std(name,d=None,p=None):
    if name not in THREAD_STANDARDS: raise ValueError("Unknown thread standard: %s"%name)
    s=THREAD_STANDARDS[name]
    if s is not None:return dict(s)
    if d is None or p is None:raise ValueError("Custom metric requires diameter and pitch")
    d,p=float(d),float(p)
    if d<=0 or p<=0:raise ValueError("Custom diameter and pitch must be > 0")
    return dict(designation="M%gx%g custom"%(d,p),diameter=d,pitch=p,profile_angle=60.0,family="Custom metric 60 degree profile",verified=False)

def _fit(name,c=None,r=None,k=None):
    if name not in FIT_PRESETS:name="FDM print"
    v=FIT_PRESETS[name]
    if v is not None:return name,dict(v)
    return name,dict(diametral_clearance=0.20 if c is None else float(c),root_relief=0.10 if r is None else float(r),crest_truncation=0.05 if k is None else float(k))

def _material(name,sh=None):
    if name not in MATERIAL_PROCESS_PRESETS:name="No compensation"
    sh=MATERIAL_PROCESS_PRESETS[name] if sh is None else float(sh)
    if sh<0 or sh>=100:raise ValueError("Shrinkage percentage must be >= 0 and < 100")
    return name,sh,1.0/(1.0-sh/100.0)

def _resolve(standard,fit,material,shrink,d,p,c,r,k):
    s=_std(standard,d,p); fn,fv=_fit(fit,c,r,k); mn,sh,sc=_material(material,shrink)
    return s,fn,fv,mn,sh,sc

def _check(f,label):
    if f.Shape.isNull() or len(f.Shape.Solids)!=1 or not f.Shape.isValid():raise RuntimeError("%s produced an invalid solid"%label)

def _meta(body,s,g,fit,mat,sh,sc,kind):
    _prop(body,"App::PropertyString","ThreadDesignation","Thread",s["designation"])
    _prop(body,"App::PropertyString","ThreadKind","Thread",kind)
    _prop(body,"App::PropertyLength","NominalDiameter","Thread",g["nominal_diameter"])
    _prop(body,"App::PropertyLength","NominalPitch","Thread",g["nominal_pitch"])
    _prop(body,"App::PropertyString","FitPreset","Fit",fit)
    _prop(body,"App::PropertyString","MaterialProcess","Print compensation",mat)
    _prop(body,"App::PropertyFloat","ShrinkagePercent","Print compensation",sh)
    _prop(body,"App::PropertyFloat","CompensationScale","Print compensation",sc)

def _igeom(s,f,sc,length,wall):
    d0,p0=float(s["diameter"]),float(s["pitch"]); L=float(length); W=float(wall)
    if min(d0,p0,L,W)<=0:raise ValueError("Diameter, pitch, length and wall must be > 0")
    d,p,L,W=d0*sc,p0*sc,L*sc,W*sc
    c=f["diametral_clearance"]*sc; rr=f["root_relief"]*sc; ct=f["crest_truncation"]*sc
    crest=d-1.082531754*p+c+2*ct; root=d+c+2*rr
    rc,rrad=crest/2,root/2; ro=d/2+W; depth=rrad-rc
    if depth<=0 or ro<=rrad+0.1:raise ValueError("Invalid internal geometry")
    return dict(nominal_diameter=d0,nominal_pitch=p0,cad_pitch=p,body_length=L,r_crest=rc,r_root=rrad,r_outer=ro,thread_depth=depth,half_width=depth*math.tan(math.radians(30)))

def _egeom(s,f,sc,length,wall):
    d0,p0=float(s["diameter"]),float(s["pitch"]); L=float(length); W=float(wall)
    if min(d0,p0,L,W)<=0:raise ValueError("Diameter, pitch, length and wall must be > 0")
    d,p,L=d0*sc,p0*sc,L*sc; rm=d/2; rr=(d-1.226869*p)/2; depth=rm-rr
    if depth<=0:raise ValueError("Invalid external geometry")
    return dict(nominal_diameter=d0,nominal_pitch=p0,cad_pitch=p,body_length=L,r_major=rm,r_root=rr,thread_depth=depth,half_width=depth*math.tan(math.radians(30)))

def _revolved_cut(doc,body,name,pts,label):
    prev=body.Tip; before=float(prev.Shape.Volume)
    sk=body.newObject("Sketcher::SketchObject",name+"Profile"); sk.AttachmentSupport=body.Origin.OriginFeatures[4]; sk.MapMode="FlatFace"
    sk.addGeometry([Part.LineSegment(pts[i],pts[(i+1)%len(pts)]) for i in range(len(pts))],False); doc.recompute()
    cut=body.newObject("PartDesign::SubtractiveRevolution",name); cut.Profile=sk; cut.ReferenceAxis=(sk,["V_Axis"]); cut.Angle=360
    try:cut.Reversed=False;cut.Midplane=False
    except Exception:pass
    doc.recompute(); _check(cut,label)
    after=float(cut.Shape.Volume); tol=max(1e-8,abs(before)*1e-10)
    if after>=before-tol:raise RuntimeError("%s did not remove material"%label)
    try:sk.ViewObject.Visibility=False
    except Exception:pass
    return cut

def _internal(doc,s,g,fit,mat,sh,sc,right=True,lead=True,lead_pitch=1.0):
    b=doc.addObject("PartDesign::Body","OpticalThread_Internal"); b.Label="%s Internal Thread v0.5.2"%s["designation"]; _meta(b,s,g,fit,mat,sh,sc,"Internal / female")
    outer=b.newObject("PartDesign::AdditiveCylinder","SleeveOuter"); outer.Radius=g["r_outer"]; outer.Height=g["body_length"]; outer.Angle=360; doc.recompute()
    eps=max(0.03,0.04*g["cad_pitch"]); bore=b.newObject("PartDesign::SubtractiveCylinder","SleeveBore"); bore.Radius=g["r_crest"]; bore.Height=g["body_length"]+2*eps; bore.Angle=360; bore.Placement=App.Placement(App.Vector(0,0,-eps),App.Rotation()); doc.recompute(); _check(bore,"Internal bore")
    sk=b.newObject("Sketcher::SketchObject","ThreadProfile"); sk.AttachmentSupport=b.Origin.OriginFeatures[4]; sk.MapMode="FlatFace"; p=g["cad_pitch"]; z=-p
    a=App.Vector(g["r_crest"],z-g["half_width"],0); c=App.Vector(g["r_root"],z,0); d=App.Vector(g["r_crest"],z+g["half_width"],0); sk.addGeometry([Part.LineSegment(a,c),Part.LineSegment(c,d),Part.LineSegment(d,a)],False); doc.recompute()
    h=b.newObject("PartDesign::SubtractiveHelix","ThreadHelix"); h.Profile=sk; h.ReferenceAxis=(sk,["V_Axis"]); h.Mode=0; h.Pitch=p; h.Height=g["body_length"]+2*p; h.Turns=h.Height.Value/p; h.Angle=0; h.Growth=0; h.LeftHanded=not bool(right); h.Reversed=0; doc.recompute(); _check(h,"SubtractiveHelix")
    tip=h
    if lead:
        H=max(0.25*p,float(lead_pitch)*p); inner=g["r_crest"]-max(0.02,0.03*p); H=min(H,max(0.05,g["r_outer"]-0.10-inner)); mouth=inner+H
        tip=_revolved_cut(doc,b,"ThreadLeadIn",[App.Vector(inner,0,0),App.Vector(mouth,0,0),App.Vector(inner,H,0)],"Female 45 degree lead-in")
    try:outer.ViewObject.Visibility=False;bore.ViewObject.Visibility=False;sk.ViewObject.Visibility=False
    except Exception:pass
    b.Tip=tip; doc.recompute(); return b

def _external(doc,s,g,fit,mat,sh,sc,right=True,lead=True,lead_pitch=1.0):
    b=doc.addObject("PartDesign::Body","OpticalThread_External"); b.Label="%s External Thread v0.5.2"%s["designation"]; _meta(b,s,g,fit,mat,sh,sc,"External / male")
    p=g["cad_pitch"]; z=-p; overlap=max(0.01*sc,0.015); rb=g["r_root"]-overlap
    sk=b.newObject("Sketcher::SketchObject","ThreadProfile"); sk.AttachmentSupport=b.Origin.OriginFeatures[4]; sk.MapMode="FlatFace"
    a=App.Vector(rb,z-g["half_width"],0); c=App.Vector(g["r_major"],z,0); d=App.Vector(rb,z+g["half_width"],0); sk.addGeometry([Part.LineSegment(a,c),Part.LineSegment(c,d),Part.LineSegment(d,a)],False); doc.recompute()
    margin=g["half_width"]+max(0.01*sc,0.01); start=-p-margin
    core=b.newObject("PartDesign::AdditiveCylinder","ThreadCore"); core.Radius=g["r_root"]; core.Height=g["body_length"]+2*p+2*margin; core.Angle=360; core.Placement=App.Placement(App.Vector(0,0,start),App.Rotation()); doc.recompute(); _check(core,"Male core")
    h=b.newObject("PartDesign::AdditiveHelix","ThreadHelix"); h.Profile=sk; h.ReferenceAxis=(sk,["V_Axis"]); h.Mode=0; h.Pitch=p; h.Height=g["body_length"]+2*p; h.Turns=h.Height.Value/p; h.Angle=0; h.Growth=0; h.LeftHanded=not bool(right); h.Reversed=0; doc.recompute(); _check(h,"AdditiveHelix")
    tip=h
    if lead:
        H=max(0.25*p,float(lead_pitch)*p); base=g["r_major"]-max(0.02,0.03*p); minr=g["r_root"]+max(0.03,0.10*g["thread_depth"]); H=min(H,max(0.05,base-minr)); reduced=base-H; outer=g["r_major"]+max(0.10,0.20*p)
        pts=[App.Vector(reduced,start,0),App.Vector(outer,start,0),App.Vector(outer,start+H,0),App.Vector(base,start+H,0)]
        tip=_revolved_cut(doc,b,"ThreadLeadIn",pts,"Male 45 degree lead-in")
    try:sk.ViewObject.Visibility=False;core.ViewObject.Visibility=False
    except Exception:pass
    b.Tip=tip; doc.recompute(); return b

def create_internal_thread(standard="T2 / M42 x 0.75",length=8.0,wall_thickness=3.0,fit="FDM print",material_process="3D PETG",shrinkage_percent=None,custom_diameter=None,custom_pitch=None,custom_clearance=None,root_relief=None,crest_truncation=None,right_hand=True,lead_in=True,lead_in_pitch=1.0,document=None):
    doc=document or App.ActiveDocument or App.newDocument("OpticalThreads"); s,fn,fv,mn,sh,sc=_resolve(standard,fit,material_process,shrinkage_percent,custom_diameter,custom_pitch,custom_clearance,root_relief,crest_truncation); return _internal(doc,s,_igeom(s,fv,sc,length,wall_thickness),fn,mn,sh,sc,right_hand,lead_in,lead_in_pitch)

def create_external_thread(standard="T2 / M42 x 0.75",length=8.0,wall_thickness=3.0,fit="FDM print",material_process="3D PETG",shrinkage_percent=None,custom_diameter=None,custom_pitch=None,custom_clearance=None,root_relief=None,crest_truncation=None,right_hand=True,lead_in=True,lead_in_pitch=1.0,document=None):
    doc=document or App.ActiveDocument or App.newDocument("OpticalThreads"); s,fn,fv,mn,sh,sc=_resolve(standard,fit,material_process,shrinkage_percent,custom_diameter,custom_pitch,custom_clearance,root_relief,crest_truncation); return _external(doc,s,_egeom(s,fv,sc,length,wall_thickness),fn,mn,sh,sc,right_hand,lead_in,lead_in_pitch)

def create_matched_pair(**kw):
    doc=kw.pop("document",None) or App.ActiveDocument or App.newDocument("OpticalThreads"); i=create_internal_thread(document=doc,**kw); e=create_external_thread(document=doc,**kw)
    try:e.Placement.Base.x+=max(i.Shape.BoundBox.XLength,e.Shape.BoundBox.XLength)+5
    except Exception:pass
    doc.recompute(); return i,e

def create_t2_internal(**kw):kw["standard"]="T2 / M42 x 0.75";return create_internal_thread(**kw)
def create_t2_external(**kw):kw["standard"]="T2 / M42 x 0.75";return create_external_thread(**kw)
def create_1_25_filter_internal(**kw):kw["standard"]="1.25in Filter / M28.5 x 0.6";return create_internal_thread(**kw)
def create_1_25_filter_external(**kw):kw["standard"]="1.25in Filter / M28.5 x 0.6";return create_external_thread(**kw)

def _show_dialog():
    if Gui is None:return create_matched_pair()
    try:
        from PySide import QtGui; Q=QtGui
    except Exception:
        from PySide2 import QtWidgets as Q
    dlg=Q.QDialog();dlg.setWindowTitle("FreeCAD Optical Threads v0.5.2");lay=Q.QFormLayout(dlg)
    out=Q.QComboBox();[out.addItem(x) for x in OUTPUT_MODES];out.setCurrentText("Matched pair")
    std=Q.QComboBox();[std.addItem(x) for x in THREAD_STANDARDS];std.setCurrentText("T2 / M42 x 0.75")
    dia=Q.QDoubleSpinBox();dia.setRange(1,500);dia.setDecimals(3);dia.setValue(42);dia.setSuffix(" mm")
    pitch=Q.QDoubleSpinBox();pitch.setRange(.1,10);pitch.setDecimals(3);pitch.setValue(.75);pitch.setSuffix(" mm")
    length=Q.QDoubleSpinBox();length.setRange(.75,200);length.setDecimals(3);length.setValue(8);length.setSuffix(" mm")
    wall=Q.QDoubleSpinBox();wall.setRange(.5,50);wall.setDecimals(3);wall.setValue(3);wall.setSuffix(" mm")
    fit=Q.QComboBox();[fit.addItem(x) for x in FIT_PRESETS];fit.setCurrentText("FDM print")
    mat=Q.QComboBox();[mat.addItem(x) for x in MATERIAL_PROCESS_PRESETS];mat.setCurrentText("3D PETG")
    shrink=Q.QDoubleSpinBox();shrink.setRange(0,20);shrink.setDecimals(3);shrink.setSingleStep(.1);shrink.setValue(.7);shrink.setSuffix(" %")
    clear=Q.QDoubleSpinBox();clear.setRange(-.5,2);clear.setDecimals(3);clear.setValue(.2);clear.setSuffix(" mm dia")
    root=Q.QDoubleSpinBox();root.setRange(0,1);root.setDecimals(3);root.setValue(.1);root.setSuffix(" mm radial")
    crest=Q.QDoubleSpinBox();crest.setRange(0,.5);crest.setDecimals(3);crest.setValue(.05);crest.setSuffix(" mm radial")
    lead=Q.QCheckBox();lead.setChecked(True); lp=Q.QDoubleSpinBox();lp.setRange(.25,3);lp.setSingleStep(.25);lp.setValue(1);lp.setSuffix(" x pitch")
    def stdchg(n):
        n=str(n); custom=n=="Custom metric";dia.setEnabled(custom);pitch.setEnabled(custom)
        if not custom:dia.setValue(THREAD_STANDARDS[n]["diameter"]);pitch.setValue(THREAD_STANDARDS[n]["pitch"])
    def fitchg(n):
        n=str(n);custom=n=="Custom";clear.setEnabled(custom);root.setEnabled(custom);crest.setEnabled(custom)
        if not custom:
            v=FIT_PRESETS[n];clear.setValue(v["diametral_clearance"]);root.setValue(v["root_relief"]);crest.setValue(v["crest_truncation"])
    def matchg(n):
        v=MATERIAL_PROCESS_PRESETS.get(str(n))
        if v is not None:shrink.setValue(v)
    std.currentTextChanged.connect(stdchg);fit.currentTextChanged.connect(fitchg);mat.currentTextChanged.connect(matchg);stdchg(std.currentText());fitchg(fit.currentText());matchg(mat.currentText())
    for lab,w in [("Output:",out),("Thread standard:",std),("Diameter:",dia),("Pitch:",pitch),("Length:",length),("Wall thickness (female):",wall),("Fit:",fit),("Material / process:",mat),("Shrinkage / compression:",shrink),("Pair diametral clearance:",clear),("Female root relief:",root),("Female crest truncation:",crest),("Thread lead-in chamfer:",lead),("Lead-in length:",lp)]:lay.addRow(lab,w)
    lay.addRow(Q.QLabel("v0.5.2: final 45 degree lead-in at actual thread entry; default 1 pitch."));btn=Q.QDialogButtonBox(Q.QDialogButtonBox.Ok|Q.QDialogButtonBox.Cancel);btn.accepted.connect(dlg.accept);btn.rejected.connect(dlg.reject);lay.addRow(btn)
    if not (dlg.exec() if hasattr(dlg,"exec") else dlg.exec_()):return None
    st,ft,om=str(std.currentText()),str(fit.currentText()),str(out.currentText());kw=dict(standard=st,length=length.value(),wall_thickness=wall.value(),fit=ft,material_process=str(mat.currentText()),shrinkage_percent=shrink.value(),custom_diameter=dia.value() if st=="Custom metric" else None,custom_pitch=pitch.value() if st=="Custom metric" else None,custom_clearance=clear.value() if ft=="Custom" else None,root_relief=root.value() if ft=="Custom" else None,crest_truncation=crest.value() if ft=="Custom" else None,lead_in=lead.isChecked(),lead_in_pitch=lp.value())
    obj=create_internal_thread(**kw) if om=="Internal / female" else create_external_thread(**kw) if om=="External / male" else create_matched_pair(**kw)
    if Gui:Gui.activeDocument().activeView().viewAxonometric();Gui.activeDocument().activeView().fitAll()
    return obj

_show_dialog()
