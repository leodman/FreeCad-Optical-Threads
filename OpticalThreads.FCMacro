# -*- coding: utf-8 -*-
"""
FreeCAD Optical Threads - v0.1.9
T2 / M42 x 0.75 internal threaded sleeve generator.

v0.1.9 boolean-safety redesign:
- no makePipeShell() thread sweep
- builds short lofts, at most about one revolution each
- neighboring turn solids overlap slightly and are fused
- preserves M42x0.75 geometry, fit corrections and PETG compensation
- preserves the cylinder-seam workaround from the working v0.1.5 geometry

License: MIT
"""

import math
import FreeCAD as App
import Part

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


FIT_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.05,
    "Normal": 0.10,
    "Loose": 0.20,
    "FDM print": 0.20,
    "Custom": None,
}

ROOT_RELIEF_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.00,
    "Normal": 0.00,
    "Loose": 0.05,
    "FDM print": 0.10,
    "Custom": None,
}

CREST_TRUNC_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.00,
    "Normal": 0.00,
    "Loose": 0.025,
    "FDM print": 0.05,
    "Custom": None,
}

MATERIAL_PROCESS_PRESETS = {
    "No compensation": 0.0,
    "3D PETG": 0.7,
}

SECTIONS_PER_TURN = 24
TURN_OVERLAP_FRACTION = 0.025


def _section_wire(theta, z_center, r_inner, r_outer, root_half, crest_half):
    """Closed four-edge radial section of the thread cutting tool."""
    c = math.cos(theta)
    s = math.sin(theta)

    def v(radius, z):
        return App.Vector(radius * c, radius * s, z)

    q1 = v(r_inner, z_center - root_half)
    q2 = v(r_outer, z_center - crest_half)
    q3 = v(r_outer, z_center + crest_half)
    q4 = v(r_inner, z_center + root_half)
    return Part.Wire([
        Part.makeLine(q1, q2),
        Part.makeLine(q2, q3),
        Part.makeLine(q3, q4),
        Part.makeLine(q4, q1),
    ])


def _make_short_loft(
    pitch,
    z_start,
    z_end,
    global_z0,
    r_inner,
    r_outer,
    root_half,
    crest_half,
    right_hand,
):
    """Make one short helical loft using the global pitch/phase relation."""
    span = z_end - z_start
    if span <= 0:
        raise RuntimeError("Invalid loft span")

    turns = span / pitch
    steps = max(6, int(math.ceil(turns * SECTIONS_PER_TURN)))
    handed = 1.0 if right_hand else -1.0
    sections = []

    for i in range(steps + 1):
        f = float(i) / float(steps)
        z = z_start + span * f
        # Phase is derived from absolute axial position. This is important:
        # adjacent short lofts then describe the same continuous helix.
        theta = handed * 2.0 * math.pi * ((z - global_z0) / pitch)
        sections.append(
            _section_wire(theta, z, r_inner, r_outer, root_half, crest_half)
        )

    loft = Part.makeLoft(sections, True, False, False, 3)
    if loft is None or loft.isNull():
        raise RuntimeError("A one-turn thread loft returned a null shape")
    if len(loft.Solids) != 1:
        raise RuntimeError(
            "A one-turn thread loft must contain one solid; got %d" % len(loft.Solids)
        )
    if hasattr(loft, "isValid") and not loft.isValid():
        raise RuntimeError("A one-turn thread loft is invalid")

    return loft, sections[0], sections[-1]


def _make_thread_cutter(
    pitch,
    height,
    z0,
    r_inner,
    r_outer,
    root_half,
    crest_half,
    right_hand,
):
    """Build the full cutter from overlapping one-turn loft solids."""
    z1 = z0 + height
    overlap = TURN_OVERLAP_FRACTION * pitch
    turn_solids = []
    first_section = None
    last_section = None

    nominal_start = z0
    index = 0
    while nominal_start < z1 - 1.0e-9:
        nominal_end = min(nominal_start + pitch, z1)
        seg_start = nominal_start if index == 0 else nominal_start - overlap
        seg_end = nominal_end if nominal_end >= z1 - 1.0e-9 else nominal_end + overlap

        solid, sec0, sec1 = _make_short_loft(
            pitch,
            seg_start,
            seg_end,
            z0,
            r_inner,
            r_outer,
            root_half,
            crest_half,
            right_hand,
        )
        if first_section is None:
            first_section = sec0
        last_section = sec1
        turn_solids.append(solid)

        nominal_start = nominal_end
        index += 1

    if not turn_solids:
        raise RuntimeError("No thread-turn solids were created")

    cutter = turn_solids[0]
    for n, turn in enumerate(turn_solids[1:], start=2):
        cutter = cutter.fuse(turn)
        if cutter is None or cutter.isNull():
            raise RuntimeError("Failed while fusing thread turn %d" % n)
        try:
            cutter = cutter.removeSplitter()
        except Exception:
            pass

    if len(cutter.Solids) != 1:
        raise RuntimeError(
            "Fused thread cutter must contain one solid; got %d" % len(cutter.Solids)
        )
    if hasattr(cutter, "isValid") and not cutter.isValid():
        raise RuntimeError("Fused thread cutter is invalid before cutting the sleeve")

    return cutter, first_section, last_section


def _finalize(shape):
    if shape is None or shape.isNull():
        raise RuntimeError("Thread boolean returned a null shape")
    try:
        refined = shape.removeSplitter()
        if refined is not None and not refined.isNull():
            shape = refined
    except Exception:
        pass
    if len(shape.Solids) != 1:
        raise RuntimeError(
            "Final threaded sleeve must contain one solid; got %d" % len(shape.Solids)
        )
    if hasattr(shape, "isValid") and not shape.isValid():
        raise RuntimeError("Final threaded sleeve is invalid")
    return shape


class T2InternalThreadProxy:
    Type = "FreeCADOpticalThreads::T2Internal"

    def __init__(self, obj):
        obj.Proxy = self

        obj.addProperty("App::PropertyString", "ThreadDesignation", "Thread")
        obj.ThreadDesignation = "T2 / M42 x 0.75 internal"
        obj.addProperty("App::PropertyLength", "NominalDiameter", "Thread")
        obj.NominalDiameter = 42.0
        obj.addProperty("App::PropertyLength", "Pitch", "Thread")
        obj.Pitch = 0.75
        obj.addProperty("App::PropertyLength", "Length", "Geometry")
        obj.Length = 8.0
        obj.addProperty("App::PropertyLength", "WallThickness", "Geometry")
        obj.WallThickness = 3.0

        obj.addProperty("App::PropertyEnumeration", "Fit", "Fit")
        obj.Fit = list(FIT_PRESETS.keys())
        obj.Fit = "FDM print"
        obj.addProperty("App::PropertyLength", "DiametralClearance", "Fit")
        obj.DiametralClearance = FIT_PRESETS["FDM print"]

        obj.addProperty("App::PropertyLength", "RootRelief", "Profile")
        obj.RootRelief = ROOT_RELIEF_PRESETS["FDM print"]
        obj.addProperty("App::PropertyLength", "CrestTruncation", "Profile")
        obj.CrestTruncation = CREST_TRUNC_PRESETS["FDM print"]

        obj.addProperty("App::PropertyEnumeration", "MaterialProcess", "Print compensation")
        obj.MaterialProcess = list(MATERIAL_PROCESS_PRESETS.keys())
        obj.MaterialProcess = "3D PETG"
        obj.addProperty("App::PropertyFloat", "ShrinkagePercent", "Print compensation")
        obj.ShrinkagePercent = MATERIAL_PROCESS_PRESETS["3D PETG"]
        obj.addProperty("App::PropertyFloat", "CompensationScale", "Print compensation")

        obj.addProperty("App::PropertyBool", "RightHand", "Thread")
        obj.RightHand = True
        obj.addProperty("App::PropertyAngle", "SeamOffset", "Advanced")
        obj.SeamOffset = 30.0
        obj.addProperty("App::PropertyBool", "DebugObjects", "Advanced")
        obj.DebugObjects = False

        obj.addProperty("App::PropertyLength", "EffectiveCrestDiameter", "Information")
        obj.addProperty("App::PropertyLength", "EffectiveRootDiameter", "Information")
        obj.addProperty("App::PropertyLength", "EffectiveRadialDepth", "Information")
        obj.addProperty("App::PropertyLength", "CADPitch", "Information")
        obj.addProperty("App::PropertyString", "GenerationMethod", "Information")
        obj.GenerationMethod = "Overlapping one-turn lofts; no PipeShell"
        obj.addProperty("App::PropertyString", "ProfileNote", "Information")
        obj.ProfileNote = (
            "v0.1.9: M42x0.75 internal thread. The cutter is built from "
            "overlapping one-turn OCCT loft solids and fused before the final cut."
        )

        for name in (
            "ThreadDesignation", "NominalDiameter", "Pitch", "CompensationScale",
            "EffectiveCrestDiameter", "EffectiveRootDiameter", "EffectiveRadialDepth",
            "CADPitch", "GenerationMethod", "ProfileNote",
        ):
            obj.setEditorMode(name, 1)

    def onChanged(self, obj, prop):
        if prop == "Fit":
            fit = str(obj.Fit)
            if FIT_PRESETS.get(fit) is not None:
                obj.DiametralClearance = FIT_PRESETS[fit]
            if ROOT_RELIEF_PRESETS.get(fit) is not None:
                obj.RootRelief = ROOT_RELIEF_PRESETS[fit]
            if CREST_TRUNC_PRESETS.get(fit) is not None:
                obj.CrestTruncation = CREST_TRUNC_PRESETS[fit]
        elif prop == "MaterialProcess":
            value = MATERIAL_PROCESS_PRESETS.get(str(obj.MaterialProcess))
            if value is not None:
                obj.ShrinkagePercent = value

    def execute(self, obj):
        d0 = float(obj.NominalDiameter.Value)
        p0 = float(obj.Pitch.Value)
        length0 = float(obj.Length.Value)
        wall0 = float(obj.WallThickness.Value)
        clearance0 = float(obj.DiametralClearance.Value)
        root_relief0 = float(obj.RootRelief.Value)
        crest_trunc0 = float(obj.CrestTruncation.Value)
        seam_offset = float(obj.SeamOffset)

        if min(d0, p0, length0, wall0) <= 0:
            raise ValueError("Diameter, pitch, length and wall thickness must be > 0")
        if root_relief0 < 0 or crest_trunc0 < 0:
            raise ValueError("RootRelief and CrestTruncation must be >= 0")

        shrink = float(obj.ShrinkagePercent)
        if shrink < 0.0 or shrink >= 100.0:
            raise ValueError("ShrinkagePercent must be >= 0 and < 100")
        scale = 1.0 / (1.0 - shrink / 100.0)
        obj.CompensationScale = scale

        d = d0 * scale
        p = p0 * scale
        length = length0 * scale
        wall = wall0 * scale
        clearance = clearance0 * scale
        root_relief = root_relief0 * scale
        crest_trunc = crest_trunc0 * scale
        obj.CADPitch = p

        basic_minor_d = d - 1.082531754 * p
        crest_d = basic_minor_d + clearance + 2.0 * crest_trunc
        root_d = d + clearance + 2.0 * root_relief
        r_crest = crest_d / 2.0
        r_root = root_d / 2.0
        r_outer = d / 2.0 + wall
        depth = r_root - r_crest

        if depth <= 0:
            raise ValueError("Invalid thread profile depth")
        if r_outer <= r_root + 0.1:
            raise ValueError("Wall thickness is too small")

        obj.EffectiveCrestDiameter = crest_d
        obj.EffectiveRootDiameter = root_d
        obj.EffectiveRadialDepth = depth

        # Plain sleeve, with the cylindrical seam moved away from the thread start.
        eps = max(0.03, 0.04 * p)
        outer = Part.makeCylinder(r_outer, length)
        bore = Part.makeCylinder(r_crest, length + 2.0 * eps, App.Vector(0, 0, -eps))
        sleeve = outer.cut(bore)
        sleeve.rotate(App.Vector(0, 0, 0), App.Vector(0, 0, 1), seam_offset)

        # Same profile dimensions used by the working v0.1.5 thread.
        z0 = -p
        cutter_height = length + 2.0 * p
        radial_overlap = max(0.10 * scale, 0.25 * depth)
        x_inner = r_crest - radial_overlap
        x_outer = r_root + max(0.04 * scale, 0.08 * depth)
        ideal_half_width = depth * math.tan(math.radians(30.0))
        root_half = min(0.36 * p, ideal_half_width + 0.08 * p)
        crest_half = 0.05 * p

        cutter, first_section, last_section = _make_thread_cutter(
            p, cutter_height, z0, x_inner, x_outer,
            root_half, crest_half, bool(obj.RightHand),
        )

        common = sleeve.common(cutter)
        if common.isNull() or common.Volume <= 1.0e-5:
            raise RuntimeError(
                "One-turn lofted thread cutter does not intersect sleeve. "
                "Enable DebugObjects and report the FreeCAD version."
            )

        result = _finalize(sleeve.cut(cutter))
        obj.Shape = result

        if bool(obj.DebugObjects):
            doc = obj.Document
            for name, shape in (
                ("DEBUG_ThreadFirstSection", first_section),
                ("DEBUG_ThreadLastSection", last_section),
                ("DEBUG_ThreadCutter", cutter),
                ("DEBUG_ThreadIntersection", common),
            ):
                old = doc.getObject(name)
                if old:
                    doc.removeObject(name)
                dbg = doc.addObject("Part::Feature", name)
                dbg.Shape = shape

        try:
            obj.ViewObject.Deviation = 0.05
            obj.ViewObject.AngularDeflection = 10.0
        except Exception:
            pass


class T2InternalViewProvider:
    def __init__(self, vobj):
        vobj.Proxy = self
    def attach(self, vobj):
        self.ViewObject = vobj
    def updateData(self, obj, prop):
        pass
    def onChanged(self, vobj, prop):
        pass
    def getDisplayModes(self, vobj):
        return []
    def getDefaultDisplayMode(self):
        return "Flat Lines"
    def setDisplayMode(self, mode):
        return mode
    def getIcon(self):
        return ""
    def dumps(self):
        return None
    def loads(self, state):
        return None


def create_t2_internal(
    length=8.0,
    wall_thickness=3.0,
    fit="FDM print",
    material_process="3D PETG",
    shrinkage_percent=None,
    custom_clearance=None,
    root_relief=None,
    crest_truncation=None,
    document=None,
):
    doc = document or App.ActiveDocument
    if doc is None:
        doc = App.newDocument("OpticalThreads")

    obj = doc.addObject("PartDesign::FeaturePython", "T2_M42x0_75_Internal")
    obj.Label = "T2 M42x0.75 Internal Thread v0.1.9"
    T2InternalThreadProxy(obj)
    if Gui:
        T2InternalViewProvider(obj.ViewObject)

    obj.Length = float(length)
    obj.WallThickness = float(wall_thickness)
    obj.Fit = fit if fit in FIT_PRESETS else "FDM print"
    obj.MaterialProcess = material_process if material_process in MATERIAL_PROCESS_PRESETS else "No compensation"
    obj.ShrinkagePercent = MATERIAL_PROCESS_PRESETS[str(obj.MaterialProcess)]
    if shrinkage_percent is not None:
        obj.ShrinkagePercent = float(shrinkage_percent)

    if obj.Fit == "Custom":
        if custom_clearance is not None:
            obj.DiametralClearance = float(custom_clearance)
        if root_relief is not None:
            obj.RootRelief = float(root_relief)
        if crest_truncation is not None:
            obj.CrestTruncation = float(crest_truncation)

    doc.recompute()
    if Gui:
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()
    return obj


def _show_dialog():
    if Gui is None:
        return create_t2_internal()

    try:
        from PySide import QtGui
        QtWidgets = QtGui
    except Exception:
        from PySide2 import QtWidgets

    dlg = QtWidgets.QDialog()
    dlg.setWindowTitle("T2 / M42 x 0.75 Internal Thread v0.1.9")
    layout = QtWidgets.QFormLayout(dlg)

    length_box = QtWidgets.QDoubleSpinBox()
    length_box.setRange(0.75, 200.0)
    length_box.setDecimals(3)
    length_box.setValue(8.0)
    length_box.setSuffix(" mm")

    wall_box = QtWidgets.QDoubleSpinBox()
    wall_box.setRange(0.5, 50.0)
    wall_box.setDecimals(3)
    wall_box.setValue(3.0)
    wall_box.setSuffix(" mm")

    fit_box = QtWidgets.QComboBox()
    for name in FIT_PRESETS:
        fit_box.addItem(name)
    fit_box.setCurrentText("FDM print")

    material_box = QtWidgets.QComboBox()
    for name in MATERIAL_PROCESS_PRESETS:
        material_box.addItem(name)
    material_box.setCurrentText("3D PETG")

    shrinkage_box = QtWidgets.QDoubleSpinBox()
    shrinkage_box.setRange(0.0, 20.0)
    shrinkage_box.setDecimals(3)
    shrinkage_box.setSingleStep(0.1)
    shrinkage_box.setSuffix(" %")
    shrinkage_box.setValue(MATERIAL_PROCESS_PRESETS["3D PETG"])

    clearance_box = QtWidgets.QDoubleSpinBox()
    clearance_box.setRange(-0.5, 2.0)
    clearance_box.setDecimals(3)
    clearance_box.setSingleStep(0.05)
    clearance_box.setSuffix(" mm dia")
    clearance_box.setValue(FIT_PRESETS["FDM print"])

    root_box = QtWidgets.QDoubleSpinBox()
    root_box.setRange(0.0, 1.0)
    root_box.setDecimals(3)
    root_box.setSingleStep(0.025)
    root_box.setSuffix(" mm radial")
    root_box.setValue(ROOT_RELIEF_PRESETS["FDM print"])

    crest_box = QtWidgets.QDoubleSpinBox()
    crest_box.setRange(0.0, 0.5)
    crest_box.setDecimals(3)
    crest_box.setSingleStep(0.025)
    crest_box.setSuffix(" mm radial")
    crest_box.setValue(CREST_TRUNC_PRESETS["FDM print"])

    def fit_changed(name):
        name = str(name)
        custom = name == "Custom"
        clearance_box.setEnabled(custom)
        root_box.setEnabled(custom)
        crest_box.setEnabled(custom)
        if not custom:
            clearance_box.setValue(FIT_PRESETS[name])
            root_box.setValue(ROOT_RELIEF_PRESETS[name])
            crest_box.setValue(CREST_TRUNC_PRESETS[name])

    def material_changed(name):
        value = MATERIAL_PROCESS_PRESETS.get(str(name))
        if value is not None:
            shrinkage_box.setValue(value)

    fit_box.currentTextChanged.connect(fit_changed)
    material_box.currentTextChanged.connect(material_changed)
    fit_changed("FDM print")
    material_changed("3D PETG")

    layout.addRow("Thread:", QtWidgets.QLabel("T2 / M42 x 0.75 internal"))
    layout.addRow("Length:", length_box)
    layout.addRow("Wall thickness:", wall_box)
    layout.addRow("Fit:", fit_box)
    layout.addRow("Material / process:", material_box)
    layout.addRow("Shrinkage / compression:", shrinkage_box)
    layout.addRow("Diametral clearance:", clearance_box)
    layout.addRow("Root relief (deeper valley):", root_box)
    layout.addRow("Crest truncation:", crest_box)

    note = QtWidgets.QLabel(
        "v0.1.9 builds the cutter one revolution at a time with overlapping lofts.\n"
        "No PipeShell is used. PETG compensation and fit controls are unchanged."
    )
    layout.addRow(note)

    buttons = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
    )
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout.addRow(buttons)

    if dlg.exec_():
        fit = str(fit_box.currentText())
        return create_t2_internal(
            length=length_box.value(),
            wall_thickness=wall_box.value(),
            fit=fit,
            material_process=str(material_box.currentText()),
            shrinkage_percent=shrinkage_box.value(),
            custom_clearance=(clearance_box.value() if fit == "Custom" else None),
            root_relief=(root_box.value() if fit == "Custom" else None),
            crest_truncation=(crest_box.value() if fit == "Custom" else None),
        )
    return None


_show_dialog()
