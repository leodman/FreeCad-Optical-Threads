# -*- coding: utf-8 -*-
"""
FreeCAD Optical Threads - v0.3.0
Parametric native Part Design optical-thread generator.

Design rules:
- thread standards are data, not geometry code
- fit correction and material/process compensation are independent layers
- generated parts remain editable native FreeCAD feature trees
- use Part Design / Sketcher features before low-level custom BRep geometry

Current verified preset:
- T2 / M42 x 0.75 internal

Also includes a Custom metric entry so the same engine can be exercised with
other diameter/pitch combinations before they are promoted to verified presets.

License: MIT
"""

import math
import FreeCAD as App
import Part
import Sketcher

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


# ---------------------------------------------------------------------------
# Data layer
# ---------------------------------------------------------------------------

THREAD_STANDARDS = {
    "T2 / M42 x 0.75": {
        "designation": "T2 / M42 x 0.75",
        "diameter": 42.0,
        "pitch": 0.75,
        "profile_angle": 60.0,
        "family": "ISO metric 60 degree profile",
        "verified": True,
    },
    "Custom metric": None,
}

# Fit corrections are expressed at nominal/model size before material scaling.
# DiametralClearance changes the female thread diametrally.
# RootRelief deepens the female valley radially.
# CrestTruncation enlarges the female crest/bore radially.
FIT_PRESETS = {
    "Basic / nominal": {
        "diametral_clearance": 0.00,
        "root_relief": 0.00,
        "crest_truncation": 0.00,
    },
    "Close": {
        "diametral_clearance": 0.05,
        "root_relief": 0.00,
        "crest_truncation": 0.00,
    },
    "Normal": {
        "diametral_clearance": 0.10,
        "root_relief": 0.00,
        "crest_truncation": 0.00,
    },
    "Loose": {
        "diametral_clearance": 0.20,
        "root_relief": 0.05,
        "crest_truncation": 0.025,
    },
    "FDM print": {
        "diametral_clearance": 0.20,
        "root_relief": 0.10,
        "crest_truncation": 0.05,
    },
    "Custom": None,
}

MATERIAL_PROCESS_PRESETS = {
    "No compensation": 0.0,
    "3D PETG": 0.7,
}


# ---------------------------------------------------------------------------
# Parameter/calculation layer
# ---------------------------------------------------------------------------

def _add_info_property(obj, prop_type, name, group, value, readonly=True):
    try:
        obj.addProperty(prop_type, name, group)
    except Exception:
        pass
    setattr(obj, name, value)
    if readonly:
        try:
            obj.setEditorMode(name, 1)
        except Exception:
            pass


def _resolve_standard(standard, custom_diameter=None, custom_pitch=None):
    if standard not in THREAD_STANDARDS:
        raise ValueError("Unknown thread standard: %s" % standard)

    preset = THREAD_STANDARDS[standard]
    if preset is not None:
        return dict(preset)

    if custom_diameter is None or custom_pitch is None:
        raise ValueError("Custom metric requires diameter and pitch")

    d = float(custom_diameter)
    p = float(custom_pitch)
    if d <= 0.0 or p <= 0.0:
        raise ValueError("Custom diameter and pitch must be > 0")

    return {
        "designation": "M%gx%g custom" % (d, p),
        "diameter": d,
        "pitch": p,
        "profile_angle": 60.0,
        "family": "Custom metric 60 degree profile",
        "verified": False,
    }


def _resolve_fit(
    fit,
    custom_clearance=None,
    root_relief=None,
    crest_truncation=None,
):
    if fit not in FIT_PRESETS:
        fit = "FDM print"

    preset = FIT_PRESETS[fit]
    if preset is not None:
        return fit, dict(preset)

    return fit, {
        "diametral_clearance": 0.20 if custom_clearance is None else float(custom_clearance),
        "root_relief": 0.10 if root_relief is None else float(root_relief),
        "crest_truncation": 0.05 if crest_truncation is None else float(crest_truncation),
    }


def _resolve_material(material_process, shrinkage_percent=None):
    if material_process not in MATERIAL_PROCESS_PRESETS:
        material_process = "No compensation"

    shrink = MATERIAL_PROCESS_PRESETS[material_process]
    if shrinkage_percent is not None:
        shrink = float(shrinkage_percent)

    if shrink < 0.0 or shrink >= 100.0:
        raise ValueError("Shrinkage percentage must be >= 0 and < 100")

    # Exact inverse linear compensation. Example: PETG 0.7% -> 1/0.993.
    scale = 1.0 / (1.0 - shrink / 100.0)
    return material_process, shrink, scale


def _compute_internal_geometry(thread, fit_values, scale, length, wall_thickness):
    """Compute female-thread geometry from nominal standard + fit + process scale."""
    d0 = float(thread["diameter"])
    p0 = float(thread["pitch"])
    angle = float(thread["profile_angle"])
    length0 = float(length)
    wall0 = float(wall_thickness)

    if min(d0, p0, length0, wall0) <= 0.0:
        raise ValueError("Diameter, pitch, length and wall thickness must be > 0")
    if abs(angle - 60.0) > 1.0e-9:
        raise ValueError("v0.3.0 currently supports 60 degree metric profiles only")

    clearance0 = float(fit_values["diametral_clearance"])
    root_relief0 = float(fit_values["root_relief"])
    crest_trunc0 = float(fit_values["crest_truncation"])
    if root_relief0 < 0.0 or crest_trunc0 < 0.0:
        raise ValueError("Root relief and crest truncation must be >= 0")

    # Material/process scaling applies to every linear dimension, including pitch.
    d = d0 * scale
    p = p0 * scale
    body_length = length0 * scale
    wall = wall0 * scale
    clearance = clearance0 * scale
    root_relief = root_relief0 * scale
    crest_trunc = crest_trunc0 * scale

    # ISO metric basic internal-thread minor diameter coefficient retained from
    # the print-tested M42 implementation. Fit corrections are applied separately.
    basic_minor_d = d - 1.082531754 * p
    crest_d = basic_minor_d + clearance + 2.0 * crest_trunc
    root_d = d + clearance + 2.0 * root_relief

    r_crest = crest_d / 2.0
    r_root = root_d / 2.0
    r_outer = d / 2.0 + wall
    thread_depth = r_root - r_crest

    if thread_depth <= 0.0:
        raise ValueError("Invalid thread profile depth")
    if r_outer <= r_root + 0.1:
        raise ValueError("Wall thickness is too small for the selected thread")

    half_width = thread_depth * math.tan(math.radians(angle / 2.0))

    return {
        "nominal_diameter": d0,
        "nominal_pitch": p0,
        "cad_diameter": d,
        "cad_pitch": p,
        "body_length": body_length,
        "wall": wall,
        "clearance_nominal": clearance0,
        "root_relief_nominal": root_relief0,
        "crest_trunc_nominal": crest_trunc0,
        "crest_diameter": crest_d,
        "root_diameter": root_d,
        "r_crest": r_crest,
        "r_root": r_root,
        "r_outer": r_outer,
        "thread_depth": thread_depth,
        "half_width": half_width,
    }


# ---------------------------------------------------------------------------
# Native FreeCAD feature layer
# ---------------------------------------------------------------------------

def _create_native_internal_thread(
    doc,
    thread,
    geom,
    fit_name,
    material_process,
    shrinkage_percent,
    compensation_scale,
    right_hand=True,
    lead_in=True,
):
    designation = thread["designation"]
    safe_name = designation.replace(" ", "_").replace("/", "").replace(".", "_").replace("x", "x")

    body = doc.addObject("PartDesign::Body", "OpticalThread_%s_Internal" % safe_name)
    body.Label = "%s Internal Thread v0.3.0" % designation

    # Design/metadata remain visible on the native Body.
    _add_info_property(body, "App::PropertyString", "ThreadDesignation", "Thread", designation)
    _add_info_property(body, "App::PropertyString", "ThreadFamily", "Thread", thread["family"])
    _add_info_property(body, "App::PropertyBool", "VerifiedPreset", "Thread", bool(thread["verified"]))
    _add_info_property(body, "App::PropertyLength", "NominalDiameter", "Thread", geom["nominal_diameter"])
    _add_info_property(body, "App::PropertyLength", "NominalPitch", "Thread", geom["nominal_pitch"])
    _add_info_property(body, "App::PropertyLength", "CADPitch", "Thread", geom["cad_pitch"])
    _add_info_property(body, "App::PropertyString", "ThreadKind", "Thread", "Internal / female")

    _add_info_property(body, "App::PropertyString", "FitPreset", "Fit", fit_name)
    _add_info_property(body, "App::PropertyLength", "DiametralClearance", "Fit", geom["clearance_nominal"])
    _add_info_property(body, "App::PropertyLength", "RootRelief", "Fit", geom["root_relief_nominal"])
    _add_info_property(body, "App::PropertyLength", "CrestTruncation", "Fit", geom["crest_trunc_nominal"])

    _add_info_property(body, "App::PropertyString", "MaterialProcess", "Print compensation", material_process)
    _add_info_property(body, "App::PropertyFloat", "ShrinkagePercent", "Print compensation", shrinkage_percent)
    _add_info_property(body, "App::PropertyFloat", "CompensationScale", "Print compensation", compensation_scale)

    _add_info_property(body, "App::PropertyLength", "EffectiveCrestDiameter", "Information", geom["crest_diameter"])
    _add_info_property(body, "App::PropertyLength", "EffectiveRootDiameter", "Information", geom["root_diameter"])
    _add_info_property(body, "App::PropertyLength", "EffectiveRadialDepth", "Information", geom["thread_depth"])
    _add_info_property(body, "App::PropertyString", "GenerationMethod", "Information", "Native Part Design primitives + Sketcher triangle + SubtractiveHelix")

    # 1) Native sleeve cylinder.
    outer = body.newObject("PartDesign::AdditiveCylinder", "SleeveOuter")
    outer.Label = "Sleeve outer cylinder"
    outer.Radius = geom["r_outer"]
    outer.Height = geom["body_length"]
    outer.Angle = 360
    doc.recompute()

    # 2) Native bore at the female crest/minor diameter.
    bore_eps = max(0.03, 0.04 * geom["cad_pitch"])
    bore = body.newObject("PartDesign::SubtractiveCylinder", "SleeveBore")
    bore.Label = "Female thread crest bore"
    bore.Radius = geom["r_crest"]
    bore.Height = geom["body_length"] + 2.0 * bore_eps
    bore.Angle = 360
    bore.Placement = App.Placement(
        App.Vector(0, 0, -bore_eps),
        App.Rotation(App.Vector(0, 0, 1), 0),
    )
    doc.recompute()

    if bore.Shape.isNull() or len(bore.Shape.Solids) != 1 or not bore.Shape.isValid():
        raise RuntimeError("Native Part Design sleeve/bore produced an invalid base solid")

    # 3) Native conical thread lead-in. It is created BEFORE the helix, so no
    # threaded-edge lookup is needed. A 45-degree lead-in reaches approximately
    # the thread root radius over one radial thread depth.
    lead_feature = None
    if lead_in:
        lead_height = max(geom["thread_depth"], 0.25 * geom["cad_pitch"])
        lead_feature = body.newObject("PartDesign::SubtractiveCone", "ThreadLeadIn")
        lead_feature.Label = "45 degree female thread lead-in"
        lead_feature.Radius1 = geom["r_root"]
        lead_feature.Radius2 = geom["r_crest"]
        lead_feature.Height = lead_height
        lead_feature.Angle = 360
        doc.recompute()

        if lead_feature.Shape.isNull() or len(lead_feature.Shape.Solids) != 1 or not lead_feature.Shape.isValid():
            raise RuntimeError("Native Part Design lead-in produced an invalid solid")

    # 4) Ideal pointed 60-degree triangular profile on the XZ plane.
    profile = body.newObject("Sketcher::SketchObject", "ThreadProfile")
    profile.Label = "%s ideal 60 degree thread triangle" % designation
    xz_plane = body.Origin.OriginFeatures[4]
    profile.AttachmentSupport = xz_plane
    profile.MapMode = "FlatFace"

    # Extend helix one pitch below and above the finite sleeve.
    p = geom["cad_pitch"]
    z_start = -p
    q1 = App.Vector(geom["r_crest"], z_start - geom["half_width"], 0)
    q2 = App.Vector(geom["r_root"], z_start, 0)
    q3 = App.Vector(geom["r_crest"], z_start + geom["half_width"], 0)

    profile.addGeometry([
        Part.LineSegment(q1, q2),
        Part.LineSegment(q2, q3),
        Part.LineSegment(q3, q1),
    ], False)
    doc.recompute()

    # 5) Native Part Design subtractive helix.
    helix = body.newObject("PartDesign::SubtractiveHelix", "ThreadHelix")
    helix.Label = "%s subtractive helix" % designation
    helix.Profile = profile
    helix.ReferenceAxis = (profile, ["V_Axis"])
    helix.Mode = 0
    helix.Pitch = p
    helix.Height = geom["body_length"] + 2.0 * p
    helix.Turns = helix.Height.Value / p
    helix.Angle = 0
    helix.Growth = 0
    helix.LeftHanded = not bool(right_hand)
    helix.Reversed = 0
    doc.recompute()

    if helix.Shape.isNull():
        raise RuntimeError("Native SubtractiveHelix returned a null shape")
    if len(helix.Shape.Solids) != 1:
        raise RuntimeError(
            "Native SubtractiveHelix must produce one solid; got %d" % len(helix.Shape.Solids)
        )
    if not helix.Shape.isValid():
        raise RuntimeError("Native SubtractiveHelix produced an invalid solid")

    try:
        outer.ViewObject.Visibility = False
        bore.ViewObject.Visibility = False
        if lead_feature is not None:
            lead_feature.ViewObject.Visibility = False
        profile.ViewObject.Visibility = False
        helix.ViewObject.Deviation = 0.05
        helix.ViewObject.AngularDeflection = 10.0
    except Exception:
        pass

    body.Tip = helix
    doc.recompute()
    return body


# ---------------------------------------------------------------------------
# Public API
# ---------------------------------------------------------------------------

def create_internal_thread(
    standard="T2 / M42 x 0.75",
    length=8.0,
    wall_thickness=3.0,
    fit="FDM print",
    material_process="3D PETG",
    shrinkage_percent=None,
    custom_diameter=None,
    custom_pitch=None,
    custom_clearance=None,
    root_relief=None,
    crest_truncation=None,
    right_hand=True,
    lead_in=True,
    document=None,
):
    doc = document or App.ActiveDocument
    if doc is None:
        doc = App.newDocument("OpticalThreads")

    thread = _resolve_standard(standard, custom_diameter, custom_pitch)
    fit_name, fit_values = _resolve_fit(
        fit,
        custom_clearance,
        root_relief,
        crest_truncation,
    )
    material_process, shrink, scale = _resolve_material(
        material_process,
        shrinkage_percent,
    )
    geom = _compute_internal_geometry(
        thread,
        fit_values,
        scale,
        length,
        wall_thickness,
    )

    body = _create_native_internal_thread(
        doc,
        thread,
        geom,
        fit_name,
        material_process,
        shrink,
        scale,
        right_hand=right_hand,
        lead_in=lead_in,
    )

    if Gui:
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()

    return body


# Backward-compatible convenience function.
def create_t2_internal(**kwargs):
    kwargs["standard"] = "T2 / M42 x 0.75"
    return create_internal_thread(**kwargs)


# ---------------------------------------------------------------------------
# Dialog
# ---------------------------------------------------------------------------

def _show_dialog():
    if Gui is None:
        return create_internal_thread()

    try:
        from PySide import QtGui
        QtWidgets = QtGui
    except Exception:
        from PySide2 import QtWidgets

    dlg = QtWidgets.QDialog()
    dlg.setWindowTitle("FreeCAD Optical Threads v0.3.0")
    layout = QtWidgets.QFormLayout(dlg)

    standard_box = QtWidgets.QComboBox()
    for name in THREAD_STANDARDS:
        standard_box.addItem(name)
    standard_box.setCurrentText("T2 / M42 x 0.75")

    diameter_box = QtWidgets.QDoubleSpinBox()
    diameter_box.setRange(1.0, 500.0)
    diameter_box.setDecimals(3)
    diameter_box.setValue(42.0)
    diameter_box.setSuffix(" mm")

    pitch_box = QtWidgets.QDoubleSpinBox()
    pitch_box.setRange(0.1, 10.0)
    pitch_box.setDecimals(3)
    pitch_box.setValue(0.75)
    pitch_box.setSuffix(" mm")

    length_box = QtWidgets.QDoubleSpinBox()
    length_box.setRange(0.75, 200.0)
    length_box.setDecimals(3)
    length_box.setValue(8.0)
    length_box.setSuffix(" mm")

    wall_box = QtWidgets.QDoubleSpinBox()
    wall_box.setRange(0.5, 50.0)
    wall_box.setDecimals(3)
    wall_box.setValue(3.0)
    wall_box.setSuffix(" mm")

    fit_box = QtWidgets.QComboBox()
    for name in FIT_PRESETS:
        fit_box.addItem(name)
    fit_box.setCurrentText("FDM print")

    material_box = QtWidgets.QComboBox()
    for name in MATERIAL_PROCESS_PRESETS:
        material_box.addItem(name)
    material_box.setCurrentText("3D PETG")

    shrinkage_box = QtWidgets.QDoubleSpinBox()
    shrinkage_box.setRange(0.0, 20.0)
    shrinkage_box.setDecimals(3)
    shrinkage_box.setSingleStep(0.1)
    shrinkage_box.setSuffix(" %")
    shrinkage_box.setValue(MATERIAL_PROCESS_PRESETS["3D PETG"])

    clearance_box = QtWidgets.QDoubleSpinBox()
    clearance_box.setRange(-0.5, 2.0)
    clearance_box.setDecimals(3)
    clearance_box.setSingleStep(0.05)
    clearance_box.setSuffix(" mm dia")
    clearance_box.setValue(FIT_PRESETS["FDM print"]["diametral_clearance"])

    root_box = QtWidgets.QDoubleSpinBox()
    root_box.setRange(0.0, 1.0)
    root_box.setDecimals(3)
    root_box.setSingleStep(0.025)
    root_box.setSuffix(" mm radial")
    root_box.setValue(FIT_PRESETS["FDM print"]["root_relief"])

    crest_box = QtWidgets.QDoubleSpinBox()
    crest_box.setRange(0.0, 0.5)
    crest_box.setDecimals(3)
    crest_box.setSingleStep(0.025)
    crest_box.setSuffix(" mm radial")
    crest_box.setValue(FIT_PRESETS["FDM print"]["crest_truncation"])

    lead_box = QtWidgets.QCheckBox()
    lead_box.setChecked(True)

    def standard_changed(name):
        name = str(name)
        is_custom = name == "Custom metric"
        diameter_box.setEnabled(is_custom)
        pitch_box.setEnabled(is_custom)
        if not is_custom:
            data = THREAD_STANDARDS[name]
            diameter_box.setValue(data["diameter"])
            pitch_box.setValue(data["pitch"])

    def fit_changed(name):
        name = str(name)
        custom = name == "Custom"
        clearance_box.setEnabled(custom)
        root_box.setEnabled(custom)
        crest_box.setEnabled(custom)
        if not custom:
            values = FIT_PRESETS[name]
            clearance_box.setValue(values["diametral_clearance"])
            root_box.setValue(values["root_relief"])
            crest_box.setValue(values["crest_truncation"])

    def material_changed(name):
        value = MATERIAL_PROCESS_PRESETS.get(str(name))
        if value is not None:
            shrinkage_box.setValue(value)

    standard_box.currentTextChanged.connect(standard_changed)
    fit_box.currentTextChanged.connect(fit_changed)
    material_box.currentTextChanged.connect(material_changed)
    standard_changed("T2 / M42 x 0.75")
    fit_changed("FDM print")
    material_changed("3D PETG")

    layout.addRow("Thread standard:", standard_box)
    layout.addRow("Diameter:", diameter_box)
    layout.addRow("Pitch:", pitch_box)
    layout.addRow("Length:", length_box)
    layout.addRow("Wall thickness:", wall_box)
    layout.addRow("Fit:", fit_box)
    layout.addRow("Material / process:", material_box)
    layout.addRow("Shrinkage / compression:", shrinkage_box)
    layout.addRow("Diametral clearance:", clearance_box)
    layout.addRow("Root relief:", root_box)
    layout.addRow("Crest truncation:", crest_box)
    layout.addRow("Native conical lead-in:", lead_box)

    note = QtWidgets.QLabel(
        "v0.3.0: standard geometry + fit correction + material compensation.\n"
        "Output remains an editable native Part Design feature tree."
    )
    layout.addRow(note)

    buttons = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
    )
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout.addRow(buttons)

    if dlg.exec_():
        standard = str(standard_box.currentText())
        fit = str(fit_box.currentText())
        return create_internal_thread(
            standard=standard,
            length=length_box.value(),
            wall_thickness=wall_box.value(),
            fit=fit,
            material_process=str(material_box.currentText()),
            shrinkage_percent=shrinkage_box.value(),
            custom_diameter=(diameter_box.value() if standard == "Custom metric" else None),
            custom_pitch=(pitch_box.value() if standard == "Custom metric" else None),
            custom_clearance=(clearance_box.value() if fit == "Custom" else None),
            root_relief=(root_box.value() if fit == "Custom" else None),
            crest_truncation=(crest_box.value() if fit == "Custom" else None),
            lead_in=bool(lead_box.isChecked()),
        )
    return None


_show_dialog()
