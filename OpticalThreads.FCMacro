# -*- coding: utf-8 -*-
"""
FreeCAD Optical Threads - v0.1.2
T2 / M42 x 0.75 internal threaded sleeve generator.

Rebuilt around the documented FreeCAD swept-profile method.
License: MIT
"""

import math
import FreeCAD as App
import Part

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None

FIT_PRESETS = {
    "Basic / nominal": 0.00,
    "Close": 0.05,
    "Normal": 0.10,
    "Loose": 0.20,
    "FDM print": 0.30,
    "Custom": None,
}


class T2InternalThreadProxy:
    Type = "FreeCADOpticalThreads::T2Internal"

    def __init__(self, obj):
        obj.Proxy = self
        obj.addProperty("App::PropertyString", "ThreadDesignation", "Thread")
        obj.ThreadDesignation = "T2 / M42 x 0.75 internal"
        obj.addProperty("App::PropertyLength", "NominalDiameter", "Thread")
        obj.NominalDiameter = 42.0
        obj.addProperty("App::PropertyLength", "Pitch", "Thread")
        obj.Pitch = 0.75
        obj.addProperty("App::PropertyLength", "Length", "Geometry")
        obj.Length = 8.0
        obj.addProperty("App::PropertyLength", "WallThickness", "Geometry")
        obj.WallThickness = 3.0
        obj.addProperty("App::PropertyEnumeration", "Fit", "Fit")
        obj.Fit = list(FIT_PRESETS.keys())
        obj.Fit = "Normal"
        obj.addProperty("App::PropertyLength", "DiametralClearance", "Fit")
        obj.DiametralClearance = FIT_PRESETS["Normal"]
        obj.addProperty("App::PropertyBool", "RightHand", "Thread")
        obj.RightHand = True
        obj.addProperty("App::PropertyAngle", "SeamOffset", "Advanced")
        obj.SeamOffset = 30.0
        obj.addProperty("App::PropertyBool", "DebugObjects", "Advanced")
        obj.DebugObjects = False
        obj.addProperty("App::PropertyString", "ProfileNote", "Information")
        obj.ProfileNote = (
            "M42x0.75, 60 degree ISO-metric-style internal profile. "
            "Female basic minor diameter D1=D-1.082531754*P. "
            "Fit presets are practical diametral clearances."
        )
        for name in ("ThreadDesignation", "NominalDiameter", "Pitch", "ProfileNote"):
            obj.setEditorMode(name, 1)

    def onChanged(self, obj, prop):
        if prop == "Fit":
            preset = FIT_PRESETS.get(str(obj.Fit))
            if preset is not None:
                obj.DiametralClearance = preset

    def execute(self, obj):
        d = float(obj.NominalDiameter.Value)
        p = float(obj.Pitch.Value)
        length = float(obj.Length.Value)
        wall = float(obj.WallThickness.Value)
        clearance_d = float(obj.DiametralClearance.Value)
        seam_offset = float(obj.SeamOffset)

        if min(d, p, length, wall) <= 0:
            raise ValueError("Diameter, pitch, length and wall thickness must be > 0")

        # ISO metric basic female-thread diameters.
        basic_minor_d = d - 1.082531754 * p
        minor_d = basic_minor_d + clearance_d
        major_d = d + clearance_d
        r_minor = minor_d / 2.0
        r_major = major_d / 2.0
        r_outer = d / 2.0 + wall

        if r_outer <= r_major + 0.1:
            raise ValueError("Wall thickness is too small")

        # Plain sleeve at the female minor diameter.
        eps = max(0.03, 0.04 * p)
        outer = Part.makeCylinder(r_outer, length)
        bore = Part.makeCylinder(
            r_minor, length + 2.0 * eps, App.Vector(0, 0, -eps)
        )
        sleeve = outer.cut(bore)

        # Avoid the cylinder seam without moving the helix/profile relative to
        # each other. This is the method recommended by the FreeCAD thread
        # tutorial: move the cylinder seam, not only one part of the sweep.
        sleeve.rotate(
            App.Vector(0, 0, 0), App.Vector(0, 0, 1), seam_offset
        )

        # Extend by one pitch at both ends so the sleeve trims the thread.
        z0 = -p
        helix_height = length + 2.0 * p

        # Radial thread depth from the ISO female basic diameters.
        depth = r_major - r_minor

        # Robust four-sided 60-degree-style cutter. Sharp mathematical tips
        # are deliberately replaced with small flats; this prevents sweep and
        # boolean degeneracies while preserving the M42x0.75 functional form.
        radial_overlap = max(0.10, 0.25 * depth)
        x_inner = r_minor - radial_overlap
        x_outer = r_major + max(0.04, 0.08 * depth)

        ideal_half_width = depth * math.tan(math.radians(30.0))
        root_half = min(0.36 * p, ideal_half_width + 0.08 * p)
        crest_half = 0.05 * p

        q1 = App.Vector(x_inner, 0, z0 - root_half)
        q2 = App.Vector(x_outer, 0, z0 - crest_half)
        q3 = App.Vector(x_outer, 0, z0 + crest_half)
        q4 = App.Vector(x_inner, 0, z0 + root_half)

        profile = Part.Wire([
            Part.makeLine(q1, q2),
            Part.makeLine(q2, q3),
            Part.makeLine(q3, q4),
            Part.makeLine(q4, q1),
        ])

        # Crucial point: the helical spine passes THROUGH the section at its
        # start, like the known-working FreeCAD makePipeShell examples.
        r_spine = x_inner + 0.45 * (x_outer - x_inner)
        try:
            helix = Part.makeLongHelix(
                p, helix_height, r_spine, 0, not bool(obj.RightHand)
            )
        except Exception:
            helix = Part.makeHelix(
                p, helix_height, r_spine, 0, not bool(obj.RightHand)
            )
        helix.translate(App.Vector(0, 0, z0))

        spine = Part.Wire(helix.Edges)
        cutter = spine.makePipeShell([profile], True, True)

        if cutter.isNull() or len(cutter.Solids) == 0:
            raise RuntimeError("Helical sweep did not create a solid cutter")

        common = sleeve.common(cutter)
        if common.isNull() or common.Volume <= 1.0e-5:
            raise RuntimeError(
                "Thread cutter does not intersect sleeve. "
                "Set DebugObjects=true and report the FreeCAD version."
            )

        result = sleeve.cut(cutter)
        if result.isNull():
            raise RuntimeError("Thread boolean cut returned a null shape")
        if hasattr(result, "isValid") and not result.isValid():
            raise RuntimeError("Thread boolean cut produced an invalid shape")

        try:
            result = result.removeSplitter()
        except Exception:
            pass

        obj.Shape = result

        # Diagnostics can be turned on from the object's Data properties.
        if bool(obj.DebugObjects):
            doc = obj.Document
            for name, shape in (
                ("DEBUG_ThreadProfile", profile),
                ("DEBUG_ThreadHelix", helix),
                ("DEBUG_ThreadCutter", cutter),
                ("DEBUG_ThreadIntersection", common),
            ):
                old = doc.getObject(name)
                if old:
                    doc.removeObject(name)
                dbg = doc.addObject("Part::Feature", name)
                dbg.Shape = shape

        try:
            obj.ViewObject.Deviation = 0.05
            obj.ViewObject.AngularDeflection = 10.0
        except Exception:
            pass


class T2InternalViewProvider:
    def __init__(self, vobj):
        vobj.Proxy = self

    def attach(self, vobj):
        self.ViewObject = vobj

    def updateData(self, obj, prop):
        pass

    def onChanged(self, vobj, prop):
        pass

    def getDisplayModes(self, vobj):
        return []

    def getDefaultDisplayMode(self):
        return "Flat Lines"

    def setDisplayMode(self, mode):
        return mode

    def getIcon(self):
        return ""

    def dumps(self):
        return None

    def loads(self, state):
        return None


def create_t2_internal(
    length=8.0,
    wall_thickness=3.0,
    fit="Normal",
    custom_clearance=None,
    document=None,
):
    doc = document or App.ActiveDocument
    if doc is None:
        doc = App.newDocument("OpticalThreads")

    obj = doc.addObject("PartDesign::FeaturePython", "T2_M42x0_75_Internal")
    obj.Label = "T2 M42x0.75 Internal Thread"
    T2InternalThreadProxy(obj)
    if Gui:
        T2InternalViewProvider(obj.ViewObject)

    obj.Length = float(length)
    obj.WallThickness = float(wall_thickness)
    obj.Fit = fit if fit in FIT_PRESETS else "Normal"
    if obj.Fit == "Custom" and custom_clearance is not None:
        obj.DiametralClearance = float(custom_clearance)

    doc.recompute()
    if Gui:
        Gui.activeDocument().activeView().viewAxonometric()
        Gui.activeDocument().activeView().fitAll()
    return obj


def _show_dialog():
    if Gui is None:
        return create_t2_internal()

    try:
        from PySide import QtGui
        QtWidgets = QtGui
    except Exception:
        from PySide2 import QtWidgets

    dlg = QtWidgets.QDialog()
    dlg.setWindowTitle("T2 / M42 x 0.75 Internal Thread")
    layout = QtWidgets.QFormLayout(dlg)

    length_box = QtWidgets.QDoubleSpinBox()
    length_box.setRange(0.75, 200.0)
    length_box.setDecimals(3)
    length_box.setValue(8.0)
    length_box.setSuffix(" mm")

    wall_box = QtWidgets.QDoubleSpinBox()
    wall_box.setRange(0.5, 50.0)
    wall_box.setDecimals(3)
    wall_box.setValue(3.0)
    wall_box.setSuffix(" mm")

    fit_box = QtWidgets.QComboBox()
    for name in FIT_PRESETS:
        fit_box.addItem(name)
    fit_box.setCurrentText("Normal")

    clearance_box = QtWidgets.QDoubleSpinBox()
    clearance_box.setRange(-0.5, 2.0)
    clearance_box.setDecimals(3)
    clearance_box.setSingleStep(0.05)
    clearance_box.setSuffix(" mm dia")
    clearance_box.setValue(FIT_PRESETS["Normal"])

    def fit_changed(name):
        value = FIT_PRESETS.get(str(name))
        clearance_box.setEnabled(value is None)
        if value is not None:
            clearance_box.setValue(value)

    fit_box.currentTextChanged.connect(fit_changed)
    fit_changed("Normal")

    layout.addRow("Thread:", QtWidgets.QLabel("T2 / M42 x 0.75 internal"))
    layout.addRow("Length:", length_box)
    layout.addRow("Wall thickness:", wall_box)
    layout.addRow("Fit:", fit_box)
    layout.addRow("Diametral clearance:", clearance_box)

    buttons = QtWidgets.QDialogButtonBox(
        QtWidgets.QDialogButtonBox.Ok | QtWidgets.QDialogButtonBox.Cancel
    )
    buttons.accepted.connect(dlg.accept)
    buttons.rejected.connect(dlg.reject)
    layout.addRow(buttons)

    if dlg.exec_():
        fit = str(fit_box.currentText())
        return create_t2_internal(
            length=length_box.value(),
            wall_thickness=wall_box.value(),
            fit=fit,
            custom_clearance=(clearance_box.value() if fit == "Custom" else None),
        )
    return None


_show_dialog()
